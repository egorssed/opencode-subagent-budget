{
  "name": "opencode-context-guard",
  "version": "1.1.0",
  "description": "OpenCode plugin that guards sub-agent capacity, enforcing per-session tool-call and context-token budgets to prevent runaway execution and context overflow.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "test": "node --experimental-strip-types --test test/guard.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "context-guard",
    "capacity-guard",
    "subagent",
    "token-budget",
    "tool-limit"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.0.0"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "latest",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "gpt-tokenizer": "^4.0.0"
  }
}
